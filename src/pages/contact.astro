---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../styles/pages/contact.css?url';
---

<BaseLayout
  title="Contact — İklima İkbal Türköz"
  description="Contact İklima İkbal Türköz for full-time roles, freelance work and research collaborations."
  styles={[page]}
>
  <div class="pp">
    <header class="bar top">
      <a class="top-back ul" href="/">
        <svg width="22" height="12" viewBox="0 0 22 12" aria-hidden="true">
          <path d="M21 6H1.5M6.5 1L1.5 6l5 5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
        </svg>
        All projects
      </a>
      <span class="bar-l" aria-hidden="true"></span>
      <span class="x bx" aria-hidden="true"></span>
      <nav class="top-nav" aria-label="Main">
        <a class="ul" href="/about">
          About
        </a>
        <a href="/contact" aria-current="page">
          Contact
        </a>
      </nav>
    </header>

    <main class="mid">
      <div class="cp">
        <p class="kick">Contact</p>
        <h1 class="h1">
          Let’s make something
          <br />
          meaningful.
        </h1>
        <p class="intro">
          Open to full-time roles, freelance work and research collaborations. Have a project in mind, a question, or
          simply want to say hello? I’d love to hear from you.
        </p>
        <a class="cta" href="mailto:ikbalturkoz@gmail.com">
          Send an email
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 14L14 2M5 2h9v9" fill="none" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </a>
      </div>

