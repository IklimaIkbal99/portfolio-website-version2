---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../styles/pages/about.css?url';
---

<BaseLayout
  title="About — İklima İkbal Türköz"
  description="About İklima İkbal Türköz: interaction and UI/UX designer in Milan. Experience, education and toolkit."
  styles={[page]}
>
  <div class="pp" id="top">
    <span class="x reg a" aria-hidden="true"></span>
    <span class="x reg b" aria-hidden="true"></span>
    <span class="x reg c" aria-hidden="true"></span>
    <span class="x reg d" aria-hidden="true"></span>

    <header class="top">
      <a class="top-back ul" href="/">
        <span aria-hidden="true">←</span>All projects
      </a>
      <div class="top-r">
        <nav class="top-nav" aria-label="Main">
          <a href="/about" aria-current="page">
            About
          </a>
          <a class="ul" href="/contact">
            Contact
          </a>
        </nav>
      </div>
    </header>

    <section class="hero" aria-labelledby="h-about">
      <div class="deco2" aria-hidden="true">
        <svg class="diag" viewBox="0 0 1672 941" preserveAspectRatio="none">
          <line x1="555" y1="25" x2="15" y2="730"></line>
        </svg>
      </div>
      <div class="deco" aria-hidden="true">
        <svg class="arc" viewBox="1250 0 422 400">
          <circle cx="1668" cy="-28" r="412"></circle>
        </svg>
        <span class="dots tr"></span>
        <span class="dots bl"></span>
        <span class="vd fd rv1"></span>
      </div>

      <div class="hg">
        <div class="pc">
          <figure class="ph" tabindex="0">
            <img
              src="/media/about/portrait.webp"
              alt="Black and white portrait of İklima İkbal Türköz in a dark sweater"
            />
            <video
              class="ph-g"
              src="/media/about/portrait-motion.mp4"
              poster="/media/about/portrait-motion-poster.webp"
              autoplay
              muted
              loop
              playsinline
              aria-hidden="true"
            ></video>
          </figure>
        </div>

        <div class="tc" style="padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px">
          <p class="kick">About</p>
          <h1 class="h1" id="h-about">
            From spatial thinking to
            <br />
            digital experiences.
          </h1>
          <p class="intro">
            I trained as an architect at Istanbul Technical University and worked in R&amp;D on sustainable
            infrastructure, before moving to Milan for an MSc in Digital and Interaction Design at Politecnico di
            Milano. Architecture taught me to design for the way people move through and experience a space. Now I bring
            the same thinking to digital products.
          </p>

          <div
            class="pil"
            role="list"
            aria-label="From architecture, through interaction design, to human-centred experiences"
          >
            <span class="hd fr a" aria-hidden="true"></span>
            <span class="hd fr b" aria-hidden="true"></span>
            <div class="pil-i" role="listitem">
              <span class="pil-c" aria-hidden="true">
                <svg class="ring" viewBox="0 0 84 84">
                  <circle cx="42" cy="42" r="41"></circle>
                </svg>
                <svg class="ic" viewBox="0 0 46 46">
                  <path d="M23 6 L39 15 L39 33 L23 42 L7 33 L7 15 Z"></path>
                  <path d="M7 15 L23 24 L39 15"></path>
                  <path d="M23 24 L23 42"></path>
                </svg>
              </span>
              <span class="pil-t">Architecture</span>
            </div>
            <div class="pil-i" role="listitem">
              <span class="pil-c" aria-hidden="true">
                <svg class="ring" viewBox="0 0 84 84">
                  <circle cx="42" cy="42" r="41"></circle>
                </svg>
                <svg class="ic" viewBox="0 0 46 46">
                  <circle cx="17" cy="23" r="12"></circle>
                  <circle cx="29" cy="23" r="12"></circle>
                </svg>
              </span>
              <span class="pil-t">Interaction Design</span>
            </div>
            <div class="pil-i" role="listitem">
              <span class="pil-c" aria-hidden="true">
                <svg class="ring" viewBox="0 0 84 84">
                  <circle cx="42" cy="42" r="41"></circle>
                </svg>
                <svg class="ic" viewBox="0 0 46 46">
                  <circle cx="23" cy="14" r="7"></circle>
                  <path d="M8 39 C8 30 14.5 25 23 25 C31.5 25 38 30 38 39 Z"></path>
                </svg>
              </span>
              <span class="pil-t">Human-centred Experiences</span>
            </div>
          </div>

          <div class="af" style="display: none">
            <div>
              <h2>Approach</h2>
              <p>
                I combine strong visual thinking with technical prototyping skills to turn ideas into engaging,
                functional and well-structured digital experiences.
              </p>
            </div>
            <span class="af-r" aria-hidden="true"></span>
            <div>
              <h2>Focus areas</h2>
              <ul class="chips" aria-label="Focus areas">
                <li>UI/UX Design</li>
                <li>Interaction Design</li>
                <li>UX Research</li>
                <li>Prototyping</li>
                <li>Game Design</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="experience" aria-label="Experience and education">
      <div class="row">
        <div class="row-k">
          <b>Experience</b>
          <span>2021 — 2025</span>
        </div>
        <div class="row-v">
          <ul class="ex">
            <li class="rv">
              <span class="ex-d">Jan — Jul 2025</span>
              <div class="ex-b">
                <span class="ex-o">
                  <b>
                    <a class="ul" href="https://breathment.com/en/" target="_blank" rel="noopener">
                      Breathment <span aria-hidden="true">↗</span>
                    </a>
                  </b>
                  <span>Remote · Munich</span>
                </span>
                <span class="ex-r">UI/UX Designer</span>
                <p class="ex-p">
                  Designed the full UI/UX of a digital health app for patients with chronic respiratory conditions, plus
                  admin screens and the product website. <a href="/projects/breathment">See Breathment →</a>
                </p>
              </div>
            </li>
            <li class="rv">
              <span class="ex-d">Nov 2022 — Sep 2023</span>
              <div class="ex-b">
                <span class="ex-o">
                  <b>
                    <a class="ul" href="https://yukselproje.com.tr/en" target="_blank" rel="noopener">
                      Yüksel Proje <span aria-hidden="true">↗</span>
                    </a>
                  </b>
                  <span>Ankara</span>
                </span>
                <span class="ex-r">Architect, R&amp;D Unit</span>
                <p class="ex-p">Contributed to R&amp;D on sustainable infrastructure and urban development projects.</p>
              </div>
            </li>
            <li class="rv">
              <span class="ex-d">Nov 2021 — Jun 2022</span>
              <div class="ex-b">
                <span class="ex-o">
                  <b>
                    <a class="ul" href="https://www.arkitera.com/author/ikbalturkoz/" target="_blank" rel="noopener">
                      Arkitera <span aria-hidden="true">↗</span>
                    </a>
                  </b>
                  <span>Istanbul</span>
                </span>
                <span class="ex-r">Editorial Intern</span>
                <p class="ex-p">Wrote news, project features and competition content for an architecture platform.</p>
              </div>
            </li>
            <li class="rv">
              <span class="ex-d">Jul — Sep 2021</span>
              <div class="ex-b">
                <span class="ex-o">
                  <b>
                    <a class="ul" href="https://ronesans.com/en" target="_blank" rel="noopener">
                      Renaissance Holding <span aria-hidden="true">↗</span>
                    </a>
                  </b>
                  <span>Ankara</span>
                </span>
                <span class="ex-r">Intern</span>
                <p class="ex-p">Supported large-scale infrastructure and commercial construction projects.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
      <div class="row">
        <div class="row-k">
          <b>Education</b>
          <span>2018 — 2026</span>
        </div>
        <div class="row-v">
          <ul class="ex">
            <li class="rv">
              <span class="ex-d">2023 — 2026</span>
              <div class="ex-b">
                <span class="ex-o">
                  <b>Politecnico di Milano</b>
                  <span>Milan</span>
                </span>
                <span class="ex-r">MSc Digital and Interaction Design</span>
                <p class="ex-p">
                  Thesis: a game for neurodivergent and neurotypical children. <a href="/projects/echo">See Echo →</a>
                </p>
              </div>
            </li>
            <li class="rv">
              <span class="ex-d">2018 — 2023</span>
              <div class="ex-b">
                <span class="ex-o">
                  <b>Istanbul Technical University</b>
                  <span>Istanbul</span>
                </span>
                <span class="ex-r">BSc Architecture</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="sec" aria-label="Background">
      <div class="row">
        <div class="row-k">
          <p class="qt">A multidisciplinary point of view for product design.</p>
        </div>
        <div class="row-v">
          <div class="mp-h" aria-hidden="true">
            <span>Architecture</span>
            <span>Interaction design</span>
          </div>
          <ul class="mp" aria-label="From architecture to interaction design">
            <li class="rv">
              <span class="mp-a">Spatial thinking</span>
              <span class="mp-x" aria-hidden="true">
                <span class="hd fr"></span>
                <i></i>
              </span>
              <span class="mp-b">User flows and information architecture</span>
            </li>
            <li class="rv">
              <span class="mp-a">Designing for people in space</span>
              <span class="mp-x" aria-hidden="true">
                <span class="hd fr"></span>
                <i></i>
              </span>
              <span class="mp-b">User-centred experiences</span>
            </li>
            <li class="rv">
              <span class="mp-a">Grids, systems and modularity</span>
              <span class="mp-x" aria-hidden="true">
                <span class="hd fr"></span>
                <i></i>
              </span>
              <span class="mp-b">Design systems</span>
            </li>
            <li class="rv">
              <span class="mp-a">Models and visualisation</span>
              <span class="mp-x" aria-hidden="true">
                <span class="hd fr"></span>
                <i></i>
              </span>
              <span class="mp-b">Prototyping and 3D</span>
            </li>
            <li class="rv">
              <span class="mp-a">Site research and analysis</span>
              <span class="mp-x" aria-hidden="true">
                <span class="hd fr"></span>
                <i></i>
              </span>
              <span class="mp-b">UX research</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="sec" aria-label="Toolkit">
      <div class="row">
        <div class="row-k">
          <b>Skills, tools and languages</b>
        </div>
        <div class="row-v">
          <div class="kit">
            <div class="rv">
              <h3>Core skills</h3>
              <ul class="chips">
                <li>UI/UX Design</li>
                <li>UX Research</li>
                <li>Interaction Design</li>
                <li>Prototyping</li>
                <li>Game Design</li>
                <li>Concept Development</li>
              </ul>
            </div>
            <div class="rv">
              <h3>Tools</h3>
              <ul class="chips">
                <li>Figma</li>
                <li>Unity</li>
                <li>ProtoPie</li>
                <li>Blender</li>
                <li>After Effects</li>
                <li>Arduino</li>
                <li>Rhinoceros</li>
                <li>C++</li>
                <li>HTML</li>
                <li>CSS</li>
              </ul>
            </div>
            <div class="rv">
              <h3>Languages</h3>
              <ul class="lng">
                <li>
                  Turkish<span>Native</span>
                </li>
                <li>
                  English<span>Fluent</span>
                </li>
                <li>
                  Italian<span>Beginner</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="dr" aria-hidden="true"></div>
      <div class="foot-b">
        <div class="foot-l">
          <a
            class="ul"
            href="https://www.linkedin.com/in/iklima-ikbal-t%C3%BCrk%C3%B6z-822b2020a"
            target="_blank"
            rel="noopener"
          >
            LinkedIn
          </a>
          <span class="sl" aria-hidden="true">
            /
          </span>
          <a class="ul" href="mailto:ikbalturkoz@gmail.com">
            Email
          </a>
          <span class="sl" aria-hidden="true">
            /
          </span>
          <a class="ul" href="/Iklima_Ikbal_Turkoz_CV.pdf" target="_blank" rel="noopener">
            CV
          </a>
        </div>
        <div class="foot-r">
          <span>© 2026 İklima İkbal Türköz</span>
          <a class="ul" href="#top">
            Back to top ↑
          </a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
