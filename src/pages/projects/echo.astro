  <section class="sec" id="s-interface" data-sec aria-labelledby="h-interface">
    <div class="sh">
      <h2 class="sh-t" id="h-interface">
        Interface
      </h2>
      <span class="sh-l" aria-hidden="true"></span>
      <span class="x sh-x" aria-hidden="true"></span>
    </div>
    <div class="stack">
      <p class="lead">Menus that feel like part of the forest.</p>
      <p class="tx">
        Menus sit on a warm, hand-crafted board inside the forest. During play, the screen holds only what a child
        needs: the room code, the signal and a way to pause.
      </p>
    </div>
    <div class="band ui">
      <div class="track rev">
        <div class="set">
          <figure class="bf">
            <img
              src="/media/echo/screen-main-menu.webp"
              alt="Echo main menu with Play, Collection, Echo Memory, Setting and Quit"
