          <polyline class="dg-p" points="80,150 260,60 440,150 620,60 800,150"></polyline>
          <polyline class="dg-p" points="80,150 260,240 440,150 620,240 800,150"></polyline>
          <polyline class="dg-ld" points="80,158 80,244"></polyline>
          <polyline class="dg-ld" points="440,158 440,244"></polyline>
          <polyline class="dg-ld" points="800,158 800,244"></polyline>
          <circle class="dg-o" cx="260" cy="60" r="3.5"></circle>
          <circle class="dg-o" cx="260" cy="240" r="3.5"></circle>
          <circle class="dg-o" cx="620" cy="60" r="3.5"></circle>
          <circle class="dg-o" cx="620" cy="240" r="3.5"></circle>
          <circle class="dg-m" cx="80" cy="150" r="4"></circle>
          <circle class="dg-m" cx="440" cy="150" r="4"></circle>
          <circle class="dg-m" cx="800" cy="150" r="4"></circle>
        </svg>
        <div class="dg-a" style="left: 185px; top: 28px; width: 150px">
          Literature review
        </div>
        <div class="dg-a" style="left: 545px; top: 28px; width: 150px">
          Game concept
        </div>
        <div class="dg-k" style="left: 10px; top: 252px; width: 140px">
          Research question
        </div>
        <div class="dg-a" style="left: 185px; top: 252px; width: 150px">
          Expert interview
        </div>
        <div class="dg-k" style="left: 365px; top: 252px; width: 150px">
          Design framework
        </div>
        <div class="dg-a" style="left: 535px; top: 252px; width: 170px">
          Multiplayer prototype
        </div>
        <div class="dg-k" style="left: 725px; top: 252px; width: 150px">
          Two play sessions
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="s-game" data-sec aria-labelledby="h-game">
    <div class="sh">
      <h2 class="sh-t" id="h-game">
        The game
      </h2>
      <span class="sh-l" aria-hidden="true"></span>
      <span class="x sh-x" aria-hidden="true"></span>
    </div>
    <div class="split">
      <div class="split-a">
        <p class="lead">A forest without a defined path.</p>
        <p class="tx">
          The map is roughly circular, with no entrance, no walls and no marked route. Each child can walk, look around
          and send a single signal, and the creatures resting in the landscape respond to it.
        </p>
      </div>
      <div class="mc rv">
        <div style="position: relative; width: 300px; height: 200px">
          <svg
            width="300"
            height="200"
            viewBox="0 0 300 200"
            aria-hidden="true"
            style="position: absolute; left: 0; top: 0; width: 300px; height: 200px; overflow: visible"
          >
            <line class="mc-ax" x1="60" y1="100" x2="240" y2="100"></line>
            <circle class="mc-r mc-ra" cx="60" cy="100" r="96"></circle>
            <circle class="mc-r mc-rb" cx="240" cy="100" r="96"></circle>
            <circle class="mc-c" cx="150" cy="100" r="11"></circle>
            <circle class="mc-p" cx="60" cy="100" r="5"></circle>
            <circle class="mc-p" cx="240" cy="100" r="5"></circle>
          </svg>
          <div class="mc-l" style="left: 18px">
            Player one
          </div>
          <div class="mc-l" style="left: 108px">
            Creature
          </div>
          <div class="mc-l" style="left: 198px">
            Player two
          </div>
        </div>
        <p class="mc-cap">One signal makes a creature stir; two signals in the same place wake it fully.</p>
      </div>
    </div>
    <div class="band game">
      <div class="track">
        <div class="set">
          <figure class="bf">
            <img
              src="/media/echo/forest-map.webp"
              alt="Isometric view of the Echo forest map with paths, streams and clearings"
              style="aspect-ratio: 769 / 433"
            />
            <figcaption>
              <span class="fc-t">The forest</span>
              <span class="fc-d">Open in every direction, with no marked path.</span>
            </figcaption>
          </figure>
          <figure class="bf">
            <img
              src="/media/echo/two-players-forest.webp"
              alt="The two player figures walking on a forest path"
              style="aspect-ratio: 728 / 434"
            />
            <figcaption>
              <span class="fc-t">Two figures, no names</span>
              <span class="fc-d">No roles or backstory, so children can simply be present.</span>
            </figcaption>
          </figure>
          <figure class="bf">
            <img
              src="/media/echo/signal-solo-vs-joint.webp"
              alt="Side by side: the small golden solo signal ring and the larger blue call signal"
